# Boomi Companion Command Center (BoomiOps AI) Backend Config
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Boomi AtomSphere API credentials (if connecting to real AtomSphere tenant)
BOOMI_ACCOUNT_ID=
BOOMI_API_TOKEN=
BOOMI_USERNAME=
BOOMI_BASE_URL=https://api.boomi.com/api/rest/v1

# Optional: External LLM provider for generative Boomi Companion queries
# (If omitted, the built-in Boomi Companion AI Autonomous Reasoning Engine is used)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Database (sign-in accounts). Default: SQLite file at backend/storage/boomiops.db.
# On Vercel you MUST set this to a hosted Postgres URL, otherwise accounts are lost on cold starts.
# DATABASE_URL=postgresql://user:password@host:5432/boomiops

# Sign-in sessions
SESSION_HOURS=12
REMEMBER_ME_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Optional: create this administrator automatically when no users exist yet
# (otherwise the first visitor sees a "Create the admin account" screen).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
